	<group name="ESTABELECIMENTO">
		<groupExpression><![CDATA[$F{ESTAB}]]></groupExpression>
		<groupHeader>
			<band height="21">
				<line>
					<reportElement x="1" y="20" width="800" height="1" uuid="289f71e5-f18e-4b0c-9492-2f9edfe2dcdd">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
					</reportElement>
					<graphicElement>
						<pen lineStyle="Double"/>
					</graphicElement>
				</line>
			</band>
		</groupHeader>
		<groupFooter>
			<band/>
		</groupFooter>
	</group>
	<group name="CONTRATO" isStartNewPage="true">
		<groupExpression><![CDATA[$F{CTR_SEQ}]]></groupExpression>
		<groupHeader>
			<band height="134">
				<textField>
					<reportElement mode="Opaque" x="0" y="0" width="70" height="14" forecolor="#000000" backcolor="#919191" uuid="3a9aa93c-7da4-40d6-9555-66036441ff07">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
					<textElement>
						<font isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["Ctr.: " + $F{CTR_SEQ}]]></textFieldExpression>
				</textField>
				<staticText>
