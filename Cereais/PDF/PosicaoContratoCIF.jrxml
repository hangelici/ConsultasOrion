	<style name="titulo_principal" style="fonte_padrão" forecolor="#25B87F" hTextAlign="Center" fontSize="14" isBold="true"/>
	<style name="subtitulo" style="fonte_padrão" hTextAlign="Center" pattern="" fontSize="12" isBold="true"/>
	<style name="infos" style="fonte_padrão" fontSize="9"/>
	<style name="card_verde" forecolor="#FFFFFF" backcolor="#25B87F"/>
	<style name="card_cinza" mode="Opaque" forecolor="#FFFFFF" backcolor="#F1F2F2"/>
	<subDataset name="NOTACONTRATO" uuid="d075e202-ebfd-4b3b-a0f6-c92f745b0f85">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="120"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="872"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="520"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="472"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="VIASOFT_PROD"/>
		<parameter name="ESTAB" class="java.lang.Integer"/>
		<parameter name="CONTRATO" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[SELECT
DADOS3.CTR_ESTAB,
DADOS3.NUMEROCM,
DADOS3.CTR_SEQ,
DADOS3.TP,
DADOS3.CTRORIGEM,
DADOS3.NF_SEQ,
DADOS3.NF_ESTAB,
DADOS3.NF_CFG,
DADOS3.NF,
DADOS3.NF_DEST,
DADOS3.NF_COMPLE,
DADOS3.NF_DATA,
DADOS3.NF_STATUS,
CASE WHEN RN = 1 THEN NF_ITEM_QTD ELSE NULL END NF_ITEM_QTD,
CASE WHEN RN = 1 THEN NF_VLUNIT ELSE NULL END NF_VLUNIT,
CASE WHEN RN = 1 THEN NF_ITEM_VLR ELSE NULL END NF_ITEM_VLR,
VLRCOMPLEMENTO,
CASE WHEN RN = 1 THEN SLD_NF_QTD ELSE NULL END SLD_NF_QTD,
CASE WHEN RN = 1 THEN PESODESCARREGAMENTO ELSE NULL END PESODESCARREGAMENTO,
CASE WHEN RN = 1 THEN PESORETENCAO ELSE NULL END PESORETENCAO,
CASE WHEN RN = 1 THEN SLD_NF_VLR ELSE NULL END SLD_NF_VLR,
CASE WHEN RN = 1 THEN JUROS ELSE NULL END JUROS,
CASE WHEN RN = 1 THEN DESCONTO ELSE NULL END DESCONTO,
CASE WHEN RN = 1 THEN PESO ELSE NULL END PESO
FROM (
SELECT DISTINCT
ROW_NUMBER()
    OVER(
        PARTITION BY CTR_ESTAB,NUMEROCM,CTR_SEQ,NF,NF_SEQ
        ORDER BY CTR_ESTAB  ,NUMEROCM , CTR_SEQ ,NF,NF_SEQ
        ) AS RN,
DADOS2.*,
PESODESCARREGAMENTO - NF_ITEM_QTD AS PESO
FROM(

SELECT DISTINCT * FROM(
SELECT
/* CONTRATO */
CONTRATONFITE.ESTAB CTR_ESTAB,
CONTRATO.NUMEROCM,
CONTRATO.DTEMISSAO,
CONTRATONFITE.CONTRATO CTR_SEQ,
NFCFG.ENTRADASAIDA AS TP,

/* NOTA FISCAL */ 
COALESCE(NFCAB_U.CTRORIGEM,0) AS CTRORIGEM,
CONTRATONFITE.SEQNOTA AS NF_SEQ,
CONTRATONFITE.ESTABNOTA AS NF_ESTAB,
NFCAB.NOTACONF AS NF_CFG,
NFCAB.NOTA AS NF,
CASE WHEN nfcfg_u_dest.u_tipoop_id in (54) THEN nfcabdest.nota ELSE NULL END NF_DEST,
complemento.nota as nf_comple,
U_DESCARGA_TRADING.DATA AS NF_DATA,
NFCAB.STATUS AS NF_STATUS,

/* QUANTIDADE E VALOR */
CASE WHEN NFCAB.NOTACONF IN (271,276,324,325) THEN CONTRATONFITE.QUANTIDADE*-1 ELSE CONTRATONFITE.QUANTIDADE END NF_ITEM_QTD,
DIVIDE(nfitem.valorunitario,COALESCE(ITEMPREMB.MULTIPLIC,1)) AS NF_VLUNIT,
CASE WHEN NFCAB.NOTACONF IN (271,276,324,325) THEN CONTRATONFITE.VALOR*-1 ELSE CONTRATONFITE.VALOR END 
+
CASE WHEN COALESCE(CTRORIGEM,0) <> 0 THEN NFCOMPLE.VALORTOTAL ELSE 0 END
NF_ITEM_VLR,
NFCOMPLE.VALORTOTAL AS VLRCOMPLEMENTO,
/* SALDO QUANTIDADE */
CASE
    /* VALIDA SE A NOTA É DE SAÍDA E O CONTRATO TAMBÉM */
    WHEN(NFCFG.NOTACONF = 291) THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN CONTRATONFITE.QUANTIDADE
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN CONTRATONFITE.QUANTIDADE
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN 0
    /* VALIDA SE A NOTA É DE SAÍDA E O CONTRATO NÃO */
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN (CONTRATONFITE.QUANTIDADE * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN (CONTRATONFITE.QUANTIDADE * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN 0
    /* VALIDA SE A NOTA É DE ENTRADA E O CONTRATO TAMBÉM */
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN CONTRATONFITE.QUANTIDADE
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN CONTRATONFITE.QUANTIDADE
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN 0
    /* VALIDA SE A NOTA É DE ENTRADA E O CONTRATO NÃO */
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN (CONTRATONFITE.QUANTIDADE * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN (CONTRATONFITE.QUANTIDADE * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN 0
END AS SLD_NF_QTD,

     CASE 
     	WHEN nfcabori.notaconf = 211  AND CONTRATO.SAFRA >= 2223 and nfcabdest.notaconf = 276 THEN 0
     	WHEN NFCAB.NOTACONF IN (271,276,324,325,216) AND CONTRATO.SAFRA < 2223 THEN CONTRATONFITE.QUANTIDADE*-1 
        WHEN NFCAB.NOTACONF = 229 AND CONTRATO.SAFRA < 2223 THEN retenorigem.pesodescarregamento 
        WHEN NFCAB.NOTACONF IN (271,276,324,325,216) AND CONTRATO.SAFRA >= 2223 THEN 0
        WHEN NFCAB.NOTACONF = 229 AND CONTRATO.SAFRA >= 2223 THEN 0 
        ELSE retenporto.pesodescarregamento END pesodescarregamento,
        
   CASE 
   		WHEN nfcabori.notaconf = 211  AND CONTRATO.SAFRA >= 2223 and nfcabdest.notaconf = 276 THEN 0
   		WHEN NFCAB.NOTACONF IN (271,276,324,325,216) AND CONTRATO.SAFRA < 2223 THEN CONTRATONFITE.QUANTIDADE*-1
        WHEN NFCAB.NOTACONF = 229 AND CONTRATO.SAFRA < 2223 THEN retenorigem.pesoretencao 
        WHEN NFCAB.NOTACONF IN (271,276,324,325,216) AND CONTRATO.SAFRA >= 2223 THEN 0
        WHEN NFCAB.NOTACONF = 229 AND CONTRATO.SAFRA >= 2223 THEN 0 
        ELSE retenporto.pesoretencao END pesoretencao,
       -- nfiteori.NOTACONF,
       -- retenorigem.pesoretencao,
  

/* SALDO VALOR */
CASE
    /* VALIDA SE A NOTA É DE SAÍDA E O CONTRATO TAMBÉM */
    WHEN(NFCFG.NOTACONF = 291) THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN CONTRATONFITE.VALOR
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN CONTRATONFITE.VALOR
    /* VALIDA SE A NOTA É DE SAÍDA E O CONTRATO NÃO */
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN (CONTRATONFITE.VALOR * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN (CONTRATONFITE.VALOR * (-1))
    /* VALIDA SE A NOTA É DE ENTRADA E O CONTRATO TAMBÉM */
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN CONTRATONFITE.VALOR
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN CONTRATONFITE.VALOR
    /* VALIDA SE A NOTA É DE ENTRADA E O CONTRATO NÃO */
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN (CONTRATONFITE.VALOR * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN (CONTRATONFITE.VALOR * (-1))
END AS SLD_NF_VLR,

COALESCE(PDUPREC.JUROS,0)JUROS,
COALESCE(PDUPREC.DESCONTO,0)DESCONTO

FROM CONTRATONFITE

INNER JOIN NFITEM
ON  (NFITEM.ESTAB       = CONTRATONFITE.ESTABNOTA)
AND (NFITEM.SEQNOTA     = CONTRATONFITE.SEQNOTA)
AND (NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM)

INNER JOIN NFCAB
ON (NFCAB.ESTAB = CONTRATONFITE.ESTABNOTA)
AND (NFCAB.SEQNOTA = CONTRATONFITE.SEQNOTA)
AND (COALESCE(NFCAB.STATUS ,'X')<> 'C')
AND NFCAB.NOTACONF NOT IN (385,388)

LEFT JOIN NFCABAGRFIN 
ON NFCAB.ESTAB = NFCABAGRFIN.ESTAB
AND NFCAB.SEQNOTA = NFCABAGRFIN.SEQNOTA

LEFT JOIN AGRFINDUPREC
ON NFCABAGRFIN.ESTAB = AGRFINDUPREC.ESTAB
AND NFCABAGRFIN.SEQPAGAMENTO = AGRFINDUPREC.SEQPAGAMENTO

left join U_DESCARGA_TRADING on
U_DESCARGA_TRADING.CHAVEACESSO = nfcab.CHAVEACESSONFE and
U_DESCARGA_TRADING.estab = nfcab.estab
    

LEFT JOIN PDUPREC
ON AGRFINDUPREC.ESTAB = PDUPREC.EMPRESA
AND AGRFINDUPREC.DUPREC = PDUPREC.DUPREC

INNER JOIN NFCFG ON
NFCFG.NOTACONF = NFCAB.NOTACONF

INNER JOIN natoperacao
ON (NATOPERACAO.naturezadaoperacao = nfcfg.naturezadaoperacao)
AND (natoperacao.entradasaida = NFCFG.entradasaida)

INNER JOIN CONTRATO
ON  (CONTRATO.ESTAB    = CONTRATONFITE.ESTAB)
AND (CONTRATO.CONTRATO = CONTRATONFITE.CONTRATO)

INNER JOIN CONTRATOCFG
ON  (CONTRATOCFG.CONTCONF    = CONTRATO.CONTCONF)

INNER JOIN SAFRAS ON
SAFRAS.SAFRA = CONTRATO.SAFRA

INNER JOIN CONTAMOV ON
CONTAMOV.NUMEROCM = CONTRATO.NUMEROCM

left join retenporto on retenporto.estab=nfitem.estab
                        and retenporto.seqnota=nfitem.seqnota
                        and retenporto.seqnotaitem=nfitem.seqnotaitem 
                        
left join nfitemapartirde on nfitemapartirde.estaborigem = nfitem.estab                        
                          and nfitemapartirde.seqnotaorigem=nfitem.seqnota
                        and nfitemapartirde.seqnotaitemorigem=nfitem.seqnotaitem
                        
left join nfcab nfcabori on nfcabori.estab = nfitemapartirde.estaborigem 
                                and nfcabori.seqnota=nfitemapartirde.seqnotaorigem
                            --    and nfiteori.seqnotaitem=nfitemapartirde.seqnotaitem 

left join nfcab nfcabdest on nfcabdest.estab = nfitemapartirde.estab
                                and nfcabdest.seqnota=nfitemapartirde.seqnota
                            --    and nfiteori.seqnotaitem=nfitemapartirde.seqnotaitem 
                            
left join nfitemcomplemento on nfitemcomplemento.estaborigem = nfcab.estab and 
                               nfitemcomplemento.seqnotaorigem = nfcab.seqnota 

left join nfcab complemento on complemento.estab = nfitemcomplemento.estab and 
                               complemento.seqnota = nfitemcomplemento.seqnota   

left join nfcfg nfcfgdest on nfcfgdest.NOTACONF = nfcabdest.NOTACONF

left join nfcfg_u nfcfg_u_dest on nfcfg_u_dest.notaconf = nfcfgdest.notaconf
                        
left join retenporto retenorigem on retenorigem.estab=nfitemapartirde.estab
                                and retenorigem.seqnota=nfitemapartirde.seqnota
                                and retenorigem.seqnotaitem=nfitemapartirde.seqnotaitem                          

LEFT JOIN ITEMPREMB ON 
    ITEMPREMB.ESTAB = NFITEM.ESTAB
    AND ITEMPREMB.ITEM = NFITEM.ITEM
    
LEFT JOIN NFCAB_U ON
    NFCAB_U.ESTAB = COMPLEMENTO.ESTAB
    AND NFCAB_U.SEQNOTA = COMPLEMENTO.SEQNOTA

LEFT JOIN NFITEM NFCOMPLE ON
    NFCOMPLE.ESTAB = NFCAB_U.ESTAB
    AND NFCOMPLE.SEQNOTA = NFCAB_U.SEQNOTA

WHERE CONTRATO.ESTAB = $P{ESTAB} 
AND CONTRATO.CONTRATO = $P{CONTRATO} 

--ORDER BY CONTRATO.ESTAB, CONTRATO.CONTRATO, NFCAB.DTENTSAI, CONTRATONFITE.SEQNOTA
)DADOS
--ORDER BY DADOS.CTR_ESTAB, DADOS.CTR_SEQ, DADOS.NF_DATA,DADOS.NF_SEQ

UNION ALL


SELECT DISTINCT * FROM(
SELECT
CONTRATONFITE.ESTAB CTR_ESTAB,
CONTRATO.NUMEROCM,
CONTRATO.DTEMISSAO,
CONTRATONFITE.CONTRATO CTR_SEQ,
NFCFG.ENTRADASAIDA AS TP,

/* NOTA FISCAL */ 
0 AS CTRORIGEM,
NFCAB_DEST.SEQNOTA AS NF_SEQ,
NFCAB_DEST.ESTAB AS NF_ESTAB,
NFCAB_DEST.NOTACONF AS NF_CFG,
NFCAB_DEST.NOTA AS NF,
0 AS NF_DEST,
0 as nf_comple,
NFCAB_DEST.DTENTSAI AS NF_DATA,
NFCAB_DEST.STATUS AS NF_STATUS,

/* QUANTIDADE E VALOR */
(nfite_dest.QUANTIDADE * -1) AS NF_ITEM_QTD,
DIVIDE(nfite_dest.valorunitario,COALESCE(ITEMPREMB.MULTIPLIC,1)) AS NF_VLUNIT,
(nfite_dest.valortotal * -1) AS NF_ITEM_VLR,
0 AS VLRCOMPLEMENTO,
/* SALDO QUANTIDADE */
(nfite_dest.QUANTIDADE * -1) AS SLD_NF_QTD,
    case when retenporto.pesodescarregamento is null then 0 else retenporto.pesodescarregamento end pesodescarregamento, 
     case when retenporto.pesoretencao  is null then 0 else retenporto.pesoretencao  end pesoretencao,
/* SALDO VALOR */
(nfite_dest.valortotal * -1) AS SLD_NF_VLR,

/* TIPO DE BAIXA */
COALESCE(PDUPREC.JUROS,0)JUROS,
COALESCE(PDUPREC.DESCONTO,0)DESCONTO

FROM NFITEMAPARTIRDE

left join nfcab nfcab_dest on nfcab_dest.estab = nfitemapartirde.estab 
                            and nfcab_dest.seqnota = nfitemapartirde.seqnota 
                            
left join nfitem nfite_dest on nfite_dest.estab = nfcab_dest.estab 
                            and nfite_dest.seqnota = nfcab_dest.seqnota 
                                                        

left join nfcab on nfcab.estab = nfitemapartirde.estaborigem 
                                and nfcab.seqnota=nfitemapartirde.seqnotaorigem
                                AND (nfcab.STATUS <> 'C')
                                
left join nfitem on nfitem.estab = nfcab.estab 
                                and nfitem.seqnota=nfcab.seqnota   

INNER JOIN CONTRATONFITE
ON  (NFITEM.ESTAB       = CONTRATONFITE.ESTABNOTA)
AND (NFITEM.SEQNOTA     = CONTRATONFITE.SEQNOTA)
AND (NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM)

LEFT JOIN NFCABAGRFIN 
ON NFCAB.ESTAB = NFCABAGRFIN.ESTAB
AND NFCAB.SEQNOTA = NFCABAGRFIN.SEQNOTA

LEFT JOIN AGRFINDUPREC
ON NFCABAGRFIN.ESTAB = AGRFINDUPREC.ESTAB
AND NFCABAGRFIN.SEQPAGAMENTO = AGRFINDUPREC.SEQPAGAMENTO

LEFT JOIN PDUPREC
ON AGRFINDUPREC.ESTAB = PDUPREC.EMPRESA
AND AGRFINDUPREC.DUPREC = PDUPREC.DUPREC

INNER JOIN NFCFG ON
NFCFG.NOTACONF = NFCAB_DEST.NOTACONF

INNER JOIN natoperacao
ON (NATOPERACAO.naturezadaoperacao = nfcfg.naturezadaoperacao)
AND (natoperacao.entradasaida = NFCFG.entradasaida)

INNER JOIN CONTRATO
ON  (CONTRATO.ESTAB    = CONTRATONFITE.ESTAB)
AND (CONTRATO.CONTRATO = CONTRATONFITE.CONTRATO)

INNER JOIN CONTRATOCFG
ON  (CONTRATOCFG.CONTCONF    = CONTRATO.CONTCONF)

INNER JOIN SAFRAS ON
SAFRAS.SAFRA = CONTRATO.SAFRA

INNER JOIN CONTAMOV ON
CONTAMOV.NUMEROCM = CONTRATO.NUMEROCM

left join retenporto on retenporto.estab=nfite_dest.estab
                        and retenporto.seqnota=nfite_dest.seqnota
                        and retenporto.seqnotaitem=nfite_dest.seqnotaitem 
                                             
LEFT JOIN ITEMPREMB ON 
    ITEMPREMB.ESTAB = NFITEM.ESTAB
    AND ITEMPREMB.ITEM = NFITEM.ITEM
    
 
    
WHERE CONTRATO.ESTAB = $P{ESTAB} 
AND CONTRATO.CONTRATO = $P{CONTRATO} 
AND NFCAB_DEST.NOTACONF NOT IN (385,388)
AND NFCAB_DEST.NOTACONF = 286
)DADOS


)DADOS2


)DADOS3
ORDER BY DADOS3.CTR_ESTAB, DADOS3.CTR_SEQ, DADOS3.NF_DATA,DADOS3.NF_SEQ]]>
		</queryString>
		<field name="CTR_ESTAB" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="CTR_ESTAB"/>
		</field>
		<field name="NUMEROCM" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="NUMEROCM"/>
		</field>
		<field name="CTR_SEQ" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="CTR_SEQ"/>
		</field>
		<field name="TP" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="TP"/>
		</field>
		<field name="CTRORIGEM" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="CTRORIGEM"/>
		</field>
		<field name="NF_SEQ" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="NF_SEQ"/>
		</field>
		<field name="NF_ESTAB" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="NF_ESTAB"/>
		</field>
		<field name="NF_CFG" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="NF_CFG"/>
		</field>
		<field name="NF" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="NF"/>
		</field>
		<field name="NF_DEST" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="NF_DEST"/>
		</field>
		<field name="NF_COMPLE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="NF_COMPLE"/>
		</field>
		<field name="NF_DATA" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.label" value="NF_DATA"/>
		</field>
		<field name="NF_STATUS" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="NF_STATUS"/>
		</field>
		<field name="NF_ITEM_QTD" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="NF_ITEM_QTD"/>
		</field>
		<field name="NF_VLUNIT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="NF_VLUNIT"/>
		</field>
		<field name="NF_ITEM_VLR" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="NF_ITEM_VLR"/>
		</field>
		<field name="VLRCOMPLEMENTO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="VLRCOMPLEMENTO"/>
		</field>
		<field name="SLD_NF_QTD" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="SLD_NF_QTD"/>
		</field>
		<field name="PESODESCARREGAMENTO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="PESODESCARREGAMENTO"/>
		</field>
		<field name="PESORETENCAO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="PESORETENCAO"/>
		</field>
		<field name="SLD_NF_VLR" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="SLD_NF_VLR"/>
		</field>
		<field name="JUROS" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="JUROS"/>
		</field>
		<field name="DESCONTO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="DESCONTO"/>
		</field>
		<field name="PESO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="PESO"/>
		</field>
		<variable name="SLD_NF_QTD1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{SLD_NF_QTD}]]></variableExpression>
		</variable>
		<variable name="SLD_NF_VLR1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{SLD_NF_VLR}]]></variableExpression>
		</variable>
		<variable name="PESODESCARREGAMENTO1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{PESODESCARREGAMENTO}]]></variableExpression>
		</variable>
		<variable name="PESORETENCAO1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{PESORETENCAO}]]></variableExpression>
		</variable>
		<variable name="NF_ITEM_QTD1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NF_ITEM_QTD}]]></variableExpression>
		</variable>
		<variable name="NF_ITEM_VLR1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NF_ITEM_VLR}]]></variableExpression>
		</variable>
		<variable name="DESCONTO" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{DESCONTO}]]></variableExpression>
		</variable>
		<variable name="JUROS" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{JUROS}]]></variableExpression>
		</variable>
		<variable name="DIF_PESO" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{PESODESCARREGAMENTO}.subtract($F{NF_ITEM_QTD})]]></variableExpression>
		</variable>
		<variable name="DIF_VALOR" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$V{DIF_PESO}.multiply($F{NF_VLUNIT})]]></variableExpression>
		</variable>
		<variable name="DIF_PESO_1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{PESODESCARREGAMENTO}.subtract($F{NF_ITEM_QTD})]]></variableExpression>
		</variable>
		<variable name="DIF_VALOR_1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$V{DIF_PESO}.multiply($F{NF_VLUNIT}).divide(new java.math.BigDecimal(60), 2, java.math.RoundingMode.HALF_UP)]]></variableExpression>
		</variable>
		<variable name="DIF_VALOR_DPL" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{CTRORIGEM}.compareTo(BigDecimal.ZERO) != 0
    ? $F{VLRCOMPLEMENTO}
    : $F{NF_ITEM_VLR}.add($V{DIF_VALOR})]]></variableExpression>
		</variable>
		<variable name="DIF_VALOR_DPL_1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NF_ITEM_VLR}.add($V{DIF_VALOR})]]></variableExpression>
		</variable>
		<variable name="NF_ITEM_QTD_G" class="java.math.BigDecimal" resetType="Group" resetGroup="NFDATA" calculation="Sum">
			<variableExpression><![CDATA[$F{NF_ITEM_QTD}]]></variableExpression>
		</variable>
		<variable name="NF_ITEM_VLR_G" class="java.math.BigDecimal" resetType="Group" resetGroup="NFDATA" calculation="Sum">
			<variableExpression><![CDATA[$F{NF_ITEM_VLR}]]></variableExpression>
		</variable>
		<variable name="PESODESCARREGAMENTO_G" class="java.math.BigDecimal" resetType="Group" resetGroup="NFDATA" calculation="Sum">
			<variableExpression><![CDATA[$F{PESODESCARREGAMENTO}]]></variableExpression>
		</variable>
		<variable name="PESORETENCAO_G" class="java.math.BigDecimal" resetType="Group" resetGroup="NFDATA" calculation="Sum">
			<variableExpression><![CDATA[$F{PESORETENCAO}]]></variableExpression>
		</variable>
		<variable name="DIF_PESO_G" class="java.math.BigDecimal" resetType="Group" resetGroup="NFDATA" calculation="Sum">
			<variableExpression><![CDATA[$F{PESODESCARREGAMENTO}.subtract($F{NF_ITEM_QTD})]]></variableExpression>
		</variable>
		<variable name="DIF_VALOR_G" class="java.math.BigDecimal" resetType="Group" resetGroup="NFDATA" calculation="Sum">
			<variableExpression><![CDATA[$V{DIF_PESO}.multiply($F{NF_VLUNIT})]]></variableExpression>
		</variable>
		<variable name="DIF_VALOR_DPL_G" class="java.math.BigDecimal" resetType="Group" resetGroup="NFDATA" calculation="Sum">
			<variableExpression><![CDATA[$F{NF_ITEM_VLR}.add($V{DIF_VALOR})]]></variableExpression>
		</variable>
		<group name="NFDATA">
			<groupExpression><![CDATA[$F{NF_DATA}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="CONTROLEFISCAL" uuid="b0c84810-7f8d-48f0-b6c2-dffcd135f7c7">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="ESTAB" class="java.lang.Integer"/>
		<parameter name="CONTRATO" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[SELECT
    COALESCE(SUM(CASE
        WHEN (X.PESODESCARREGAMENTO - X.NF_ITEM_QTD) < 0
        THEN ABS(X.PESODESCARREGAMENTO - X.NF_ITEM_QTD)
        ELSE 0
    END), 0) AS CF_DEVOL_QTD,
    COALESCE(SUM(CASE
        WHEN (X.PESODESCARREGAMENTO - X.NF_ITEM_QTD) < 0
        THEN ABS((X.PESODESCARREGAMENTO - X.NF_ITEM_QTD) * X.NF_VLUNIT)
        ELSE 0
    END), 0) AS CF_DEVOL_VLR,
    COALESCE(SUM(CASE
        WHEN (X.PESODESCARREGAMENTO - X.NF_ITEM_QTD) > 0
        THEN (X.PESODESCARREGAMENTO - X.NF_ITEM_QTD)
        ELSE 0
    END), 0) AS CF_COMP_QTD,
    COALESCE(SUM(CASE
        WHEN (X.PESODESCARREGAMENTO - X.NF_ITEM_QTD) > 0
        THEN (X.PESODESCARREGAMENTO - X.NF_ITEM_QTD) * X.NF_VLUNIT
        ELSE 0
    END), 0) AS CF_COMP_VLR
FROM (
SELECT
DADOS3.CTR_ESTAB,
DADOS3.NUMEROCM,
DADOS3.CTR_SEQ,
DADOS3.TP,
DADOS3.CTRORIGEM,
DADOS3.NF_SEQ,
DADOS3.NF_ESTAB,
DADOS3.NF_CFG,
DADOS3.NF,
DADOS3.NF_DEST,
DADOS3.NF_COMPLE,
DADOS3.NF_DATA,
DADOS3.NF_STATUS,
CASE WHEN RN = 1 THEN NF_ITEM_QTD ELSE NULL END NF_ITEM_QTD,
CASE WHEN RN = 1 THEN NF_VLUNIT ELSE NULL END NF_VLUNIT,
CASE WHEN RN = 1 THEN NF_ITEM_VLR ELSE NULL END NF_ITEM_VLR,
VLRCOMPLEMENTO,
CASE WHEN RN = 1 THEN SLD_NF_QTD ELSE NULL END SLD_NF_QTD,
CASE WHEN RN = 1 THEN PESODESCARREGAMENTO ELSE NULL END PESODESCARREGAMENTO,
CASE WHEN RN = 1 THEN PESORETENCAO ELSE NULL END PESORETENCAO,
CASE WHEN RN = 1 THEN SLD_NF_VLR ELSE NULL END SLD_NF_VLR,
CASE WHEN RN = 1 THEN JUROS ELSE NULL END JUROS,
CASE WHEN RN = 1 THEN DESCONTO ELSE NULL END DESCONTO,
CASE WHEN RN = 1 THEN PESO ELSE NULL END PESO
FROM (
SELECT DISTINCT
ROW_NUMBER()
    OVER(
        PARTITION BY CTR_ESTAB,NUMEROCM,CTR_SEQ,NF,NF_SEQ
        ORDER BY CTR_ESTAB  ,NUMEROCM , CTR_SEQ ,NF,NF_SEQ
        ) AS RN,
DADOS2.*,
PESODESCARREGAMENTO - NF_ITEM_QTD AS PESO
FROM(

SELECT DISTINCT * FROM(
SELECT
/* CONTRATO */
CONTRATONFITE.ESTAB CTR_ESTAB,
CONTRATO.NUMEROCM,
CONTRATO.DTEMISSAO,
CONTRATONFITE.CONTRATO CTR_SEQ,
NFCFG.ENTRADASAIDA AS TP,

/* NOTA FISCAL */ 
COALESCE(NFCAB_U.CTRORIGEM,0) AS CTRORIGEM,
CONTRATONFITE.SEQNOTA AS NF_SEQ,
CONTRATONFITE.ESTABNOTA AS NF_ESTAB,
NFCAB.NOTACONF AS NF_CFG,
NFCAB.NOTA AS NF,
CASE WHEN nfcfg_u_dest.u_tipoop_id in (54) THEN nfcabdest.nota ELSE NULL END NF_DEST,
complemento.nota as nf_comple,
U_DESCARGA_TRADING.DATA AS NF_DATA,
NFCAB.STATUS AS NF_STATUS,

/* QUANTIDADE E VALOR */
CASE WHEN NFCAB.NOTACONF IN (271,276,324,325) THEN CONTRATONFITE.QUANTIDADE*-1 ELSE CONTRATONFITE.QUANTIDADE END NF_ITEM_QTD,
DIVIDE(nfitem.valorunitario,COALESCE(ITEMPREMB.MULTIPLIC,1)) AS NF_VLUNIT,
CASE WHEN NFCAB.NOTACONF IN (271,276,324,325) THEN CONTRATONFITE.VALOR*-1 ELSE CONTRATONFITE.VALOR END 
+
CASE WHEN COALESCE(CTRORIGEM,0) <> 0 THEN NFCOMPLE.VALORTOTAL ELSE 0 END
NF_ITEM_VLR,
NFCOMPLE.VALORTOTAL AS VLRCOMPLEMENTO,
/* SALDO QUANTIDADE */
CASE
    /* VALIDA SE A NOTA É DE SAÍDA E O CONTRATO TAMBÉM */
    WHEN(NFCFG.NOTACONF = 291) THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN CONTRATONFITE.QUANTIDADE
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN CONTRATONFITE.QUANTIDADE
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN 0
    /* VALIDA SE A NOTA É DE SAÍDA E O CONTRATO NÃO */
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN (CONTRATONFITE.QUANTIDADE * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN (CONTRATONFITE.QUANTIDADE * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN 0
    /* VALIDA SE A NOTA É DE ENTRADA E O CONTRATO TAMBÉM */
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN CONTRATONFITE.QUANTIDADE
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN CONTRATONFITE.QUANTIDADE
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN 0
    /* VALIDA SE A NOTA É DE ENTRADA E O CONTRATO NÃO */
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN (CONTRATONFITE.QUANTIDADE * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN (CONTRATONFITE.QUANTIDADE * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN 0
END AS SLD_NF_QTD,

     CASE 
     	WHEN nfcabori.notaconf = 211  AND CONTRATO.SAFRA >= 2223 and nfcabdest.notaconf = 276 THEN 0
     	WHEN NFCAB.NOTACONF IN (271,276,324,325,216) AND CONTRATO.SAFRA < 2223 THEN CONTRATONFITE.QUANTIDADE*-1 
        WHEN NFCAB.NOTACONF = 229 AND CONTRATO.SAFRA < 2223 THEN retenorigem.pesodescarregamento 
        WHEN NFCAB.NOTACONF IN (271,276,324,325,216) AND CONTRATO.SAFRA >= 2223 THEN 0
        WHEN NFCAB.NOTACONF = 229 AND CONTRATO.SAFRA >= 2223 THEN 0 
        ELSE retenporto.pesodescarregamento END pesodescarregamento,
        
   CASE 
   		WHEN nfcabori.notaconf = 211  AND CONTRATO.SAFRA >= 2223 and nfcabdest.notaconf = 276 THEN 0
   		WHEN NFCAB.NOTACONF IN (271,276,324,325,216) AND CONTRATO.SAFRA < 2223 THEN CONTRATONFITE.QUANTIDADE*-1
        WHEN NFCAB.NOTACONF = 229 AND CONTRATO.SAFRA < 2223 THEN retenorigem.pesoretencao 
        WHEN NFCAB.NOTACONF IN (271,276,324,325,216) AND CONTRATO.SAFRA >= 2223 THEN 0
        WHEN NFCAB.NOTACONF = 229 AND CONTRATO.SAFRA >= 2223 THEN 0 
        ELSE retenporto.pesoretencao END pesoretencao,
       -- nfiteori.NOTACONF,
       -- retenorigem.pesoretencao,
  

/* SALDO VALOR */
CASE
    /* VALIDA SE A NOTA É DE SAÍDA E O CONTRATO TAMBÉM */
    WHEN(NFCFG.NOTACONF = 291) THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN CONTRATONFITE.VALOR
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN CONTRATONFITE.VALOR
    /* VALIDA SE A NOTA É DE SAÍDA E O CONTRATO NÃO */
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN (CONTRATONFITE.VALOR * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'S' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN (CONTRATONFITE.VALOR * (-1))
    /* VALIDA SE A NOTA É DE ENTRADA E O CONTRATO TAMBÉM */
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN CONTRATONFITE.VALOR
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'E' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN CONTRATONFITE.VALOR
    /* VALIDA SE A NOTA É DE ENTRADA E O CONTRATO NÃO */
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'A') THEN (CONTRATONFITE.VALOR * (-1))
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'R') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'Q') THEN 0
    WHEN (NFCFG.ENTRADASAIDA = 'E' AND CONTRATOCFG.ENTRADASAIDA = 'S' AND CONTRATONFITE.TIPOBAIXA = 'V') THEN (CONTRATONFITE.VALOR * (-1))
END AS SLD_NF_VLR,

COALESCE(PDUPREC.JUROS,0)JUROS,
COALESCE(PDUPREC.DESCONTO,0)DESCONTO

FROM CONTRATONFITE

INNER JOIN NFITEM
ON  (NFITEM.ESTAB       = CONTRATONFITE.ESTABNOTA)
AND (NFITEM.SEQNOTA     = CONTRATONFITE.SEQNOTA)
AND (NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM)

INNER JOIN NFCAB
ON (NFCAB.ESTAB = CONTRATONFITE.ESTABNOTA)
AND (NFCAB.SEQNOTA = CONTRATONFITE.SEQNOTA)
AND (COALESCE(NFCAB.STATUS ,'X')<> 'C')
AND NFCAB.NOTACONF NOT IN (385,388)

LEFT JOIN NFCABAGRFIN 
ON NFCAB.ESTAB = NFCABAGRFIN.ESTAB
AND NFCAB.SEQNOTA = NFCABAGRFIN.SEQNOTA

LEFT JOIN AGRFINDUPREC
ON NFCABAGRFIN.ESTAB = AGRFINDUPREC.ESTAB
AND NFCABAGRFIN.SEQPAGAMENTO = AGRFINDUPREC.SEQPAGAMENTO

left join U_DESCARGA_TRADING on
U_DESCARGA_TRADING.CHAVEACESSO = nfcab.CHAVEACESSONFE and
U_DESCARGA_TRADING.estab = nfcab.estab
    

LEFT JOIN PDUPREC
ON AGRFINDUPREC.ESTAB = PDUPREC.EMPRESA
AND AGRFINDUPREC.DUPREC = PDUPREC.DUPREC

INNER JOIN NFCFG ON
NFCFG.NOTACONF = NFCAB.NOTACONF

INNER JOIN natoperacao
ON (NATOPERACAO.naturezadaoperacao = nfcfg.naturezadaoperacao)
AND (natoperacao.entradasaida = NFCFG.entradasaida)

INNER JOIN CONTRATO
ON  (CONTRATO.ESTAB    = CONTRATONFITE.ESTAB)
AND (CONTRATO.CONTRATO = CONTRATONFITE.CONTRATO)

INNER JOIN CONTRATOCFG
ON  (CONTRATOCFG.CONTCONF    = CONTRATO.CONTCONF)

INNER JOIN SAFRAS ON
SAFRAS.SAFRA = CONTRATO.SAFRA

INNER JOIN CONTAMOV ON
CONTAMOV.NUMEROCM = CONTRATO.NUMEROCM

left join retenporto on retenporto.estab=nfitem.estab
                        and retenporto.seqnota=nfitem.seqnota
                        and retenporto.seqnotaitem=nfitem.seqnotaitem 
                        
left join nfitemapartirde on nfitemapartirde.estaborigem = nfitem.estab                        
                          and nfitemapartirde.seqnotaorigem=nfitem.seqnota
                        and nfitemapartirde.seqnotaitemorigem=nfitem.seqnotaitem
                        
left join nfcab nfcabori on nfcabori.estab = nfitemapartirde.estaborigem 
                                and nfcabori.seqnota=nfitemapartirde.seqnotaorigem
                            --    and nfiteori.seqnotaitem=nfitemapartirde.seqnotaitem 

left join nfcab nfcabdest on nfcabdest.estab = nfitemapartirde.estab
                                and nfcabdest.seqnota=nfitemapartirde.seqnota
                            --    and nfiteori.seqnotaitem=nfitemapartirde.seqnotaitem 
                            
left join nfitemcomplemento on nfitemcomplemento.estaborigem = nfcab.estab and 
                               nfitemcomplemento.seqnotaorigem = nfcab.seqnota 

left join nfcab complemento on complemento.estab = nfitemcomplemento.estab and 
                               complemento.seqnota = nfitemcomplemento.seqnota   

left join nfcfg nfcfgdest on nfcfgdest.NOTACONF = nfcabdest.NOTACONF

left join nfcfg_u nfcfg_u_dest on nfcfg_u_dest.notaconf = nfcfgdest.notaconf
                        
left join retenporto retenorigem on retenorigem.estab=nfitemapartirde.estab
                                and retenorigem.seqnota=nfitemapartirde.seqnota
                                and retenorigem.seqnotaitem=nfitemapartirde.seqnotaitem                          

LEFT JOIN ITEMPREMB ON 
    ITEMPREMB.ESTAB = NFITEM.ESTAB
    AND ITEMPREMB.ITEM = NFITEM.ITEM
    
LEFT JOIN NFCAB_U ON
    NFCAB_U.ESTAB = COMPLEMENTO.ESTAB
    AND NFCAB_U.SEQNOTA = COMPLEMENTO.SEQNOTA

LEFT JOIN NFITEM NFCOMPLE ON
    NFCOMPLE.ESTAB = NFCAB_U.ESTAB
    AND NFCOMPLE.SEQNOTA = NFCAB_U.SEQNOTA

WHERE CONTRATO.ESTAB = $P{ESTAB} 
AND CONTRATO.CONTRATO = $P{CONTRATO} 

--ORDER BY CONTRATO.ESTAB, CONTRATO.CONTRATO, NFCAB.DTENTSAI, CONTRATONFITE.SEQNOTA
)DADOS
--ORDER BY DADOS.CTR_ESTAB, DADOS.CTR_SEQ, DADOS.NF_DATA,DADOS.NF_SEQ

UNION ALL


SELECT DISTINCT * FROM(
SELECT
CONTRATONFITE.ESTAB CTR_ESTAB,
CONTRATO.NUMEROCM,
CONTRATO.DTEMISSAO,
CONTRATONFITE.CONTRATO CTR_SEQ,
NFCFG.ENTRADASAIDA AS TP,

/* NOTA FISCAL */ 
0 AS CTRORIGEM,
NFCAB_DEST.SEQNOTA AS NF_SEQ,
NFCAB_DEST.ESTAB AS NF_ESTAB,
NFCAB_DEST.NOTACONF AS NF_CFG,
NFCAB_DEST.NOTA AS NF,
0 AS NF_DEST,
0 as nf_comple,
NFCAB_DEST.DTENTSAI AS NF_DATA,
NFCAB_DEST.STATUS AS NF_STATUS,

/* QUANTIDADE E VALOR */
(nfite_dest.QUANTIDADE * -1) AS NF_ITEM_QTD,
DIVIDE(nfite_dest.valorunitario,COALESCE(ITEMPREMB.MULTIPLIC,1)) AS NF_VLUNIT,
(nfite_dest.valortotal * -1) AS NF_ITEM_VLR,
0 AS VLRCOMPLEMENTO,
/* SALDO QUANTIDADE */
(nfite_dest.QUANTIDADE * -1) AS SLD_NF_QTD,
    case when retenporto.pesodescarregamento is null then 0 else retenporto.pesodescarregamento end pesodescarregamento, 
     case when retenporto.pesoretencao  is null then 0 else retenporto.pesoretencao  end pesoretencao,
/* SALDO VALOR */
(nfite_dest.valortotal * -1) AS SLD_NF_VLR,

/* TIPO DE BAIXA */
COALESCE(PDUPREC.JUROS,0)JUROS,
COALESCE(PDUPREC.DESCONTO,0)DESCONTO

FROM NFITEMAPARTIRDE

left join nfcab nfcab_dest on nfcab_dest.estab = nfitemapartirde.estab 
                            and nfcab_dest.seqnota = nfitemapartirde.seqnota 
                            
left join nfitem nfite_dest on nfite_dest.estab = nfcab_dest.estab 
                            and nfite_dest.seqnota = nfcab_dest.seqnota 
                                                        

left join nfcab on nfcab.estab = nfitemapartirde.estaborigem 
                                and nfcab.seqnota=nfitemapartirde.seqnotaorigem
                                AND (nfcab.STATUS <> 'C')
                                
left join nfitem on nfitem.estab = nfcab.estab 
                                and nfitem.seqnota=nfcab.seqnota   

INNER JOIN CONTRATONFITE
ON  (NFITEM.ESTAB       = CONTRATONFITE.ESTABNOTA)
AND (NFITEM.SEQNOTA     = CONTRATONFITE.SEQNOTA)
AND (NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM)

LEFT JOIN NFCABAGRFIN 
ON NFCAB.ESTAB = NFCABAGRFIN.ESTAB
AND NFCAB.SEQNOTA = NFCABAGRFIN.SEQNOTA

LEFT JOIN AGRFINDUPREC
ON NFCABAGRFIN.ESTAB = AGRFINDUPREC.ESTAB
AND NFCABAGRFIN.SEQPAGAMENTO = AGRFINDUPREC.SEQPAGAMENTO

LEFT JOIN PDUPREC
ON AGRFINDUPREC.ESTAB = PDUPREC.EMPRESA
AND AGRFINDUPREC.DUPREC = PDUPREC.DUPREC

INNER JOIN NFCFG ON
NFCFG.NOTACONF = NFCAB_DEST.NOTACONF

INNER JOIN natoperacao
ON (NATOPERACAO.naturezadaoperacao = nfcfg.naturezadaoperacao)
AND (natoperacao.entradasaida = NFCFG.entradasaida)

INNER JOIN CONTRATO
ON  (CONTRATO.ESTAB    = CONTRATONFITE.ESTAB)
AND (CONTRATO.CONTRATO = CONTRATONFITE.CONTRATO)

INNER JOIN CONTRATOCFG
ON  (CONTRATOCFG.CONTCONF    = CONTRATO.CONTCONF)

INNER JOIN SAFRAS ON
SAFRAS.SAFRA = CONTRATO.SAFRA

INNER JOIN CONTAMOV ON
CONTAMOV.NUMEROCM = CONTRATO.NUMEROCM

left join retenporto on retenporto.estab=nfite_dest.estab
                        and retenporto.seqnota=nfite_dest.seqnota
                        and retenporto.seqnotaitem=nfite_dest.seqnotaitem 
                                             
LEFT JOIN ITEMPREMB ON 
    ITEMPREMB.ESTAB = NFITEM.ESTAB
    AND ITEMPREMB.ITEM = NFITEM.ITEM
    
 
    
WHERE CONTRATO.ESTAB = $P{ESTAB} 
AND CONTRATO.CONTRATO = $P{CONTRATO} 
AND NFCAB_DEST.NOTACONF NOT IN (385,388)
AND NFCAB_DEST.NOTACONF = 286
)DADOS


)DADOS2


)DADOS3
) X]]>
		</queryString>
		<field name="CF_DEVOL_QTD" class="java.math.BigDecimal"/>
		<field name="CF_DEVOL_VLR" class="java.math.BigDecimal"/>
		<field name="CF_COMP_QTD" class="java.math.BigDecimal"/>
		<field name="CF_COMP_VLR" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="FINANCEIRO" uuid="95b5f097-84d0-4694-a4fe-0669135d95ce">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ORAPRD"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="122"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="870"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="950"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="36"/>
		<parameter name="ESTAB" class="java.lang.Integer"/>
		<parameter name="CONTRATO" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[WITH CTE_CONTRATO_SAI AS (
    SELECT DISTINCT
        CONTRATONFITE.ESTAB, 
        CONTRATONFITE.CONTRATO, 
        NFCAB.DTENTSAI, 
        CONTRATONFITE.SEQNOTA,
        CASE 
            WHEN NFCAB.NOTACONF IN (271, 276, 324, 325, 216) 
            THEN NFCAB.NOTA || '-' || NFCAB.SERIE 
            ELSE VDUPREC.DUPREC 
        END AS DUPREC,
        CASE 
            WHEN NFCAB.NOTACONF IN (271, 276, 324, 325, 216) 
            THEN NFCAB.DTEMISSAO 
            ELSE VDUPREC.DTVENCTO 
        END AS DTVENCTO,
        CASE 
            WHEN NFCAB.NOTACONF IN (271, 276, 324, 325, 216) 
            THEN NFCAB.VALOR * -1 
            ELSE VDUPREC.VALOR 
        END AS VALOR,
        CASE 
            WHEN NFCAB.NOTACONF IN (271, 276, 324, 325, 216) 
            THEN 0 
            ELSE VDUPREC.SALDO 
        END AS SALDO,
        CASE 
            WHEN NFCAB.NOTACONF IN (271, 276, 324, 325, 216) 
            THEN NFCAB.VALOR * -1 
            ELSE (VDUPREC.VALOR - VDUPREC.SALDO) 
        END AS RECEBIDO
    FROM CONTRATONFITE
    INNER JOIN NFCAB ON (NFCAB.ESTAB = CONTRATONFITE.ESTABNOTA)
        AND (NFCAB.SEQNOTA = CONTRATONFITE.SEQNOTA)
        AND (NFCAB.STATUS <> 'C' OR NFCAB.STATUS IS NULL)
    INNER JOIN CONTRATO ON (CONTRATO.ESTAB = CONTRATONFITE.ESTAB)
        AND (CONTRATO.CONTRATO = CONTRATONFITE.CONTRATO)
    INNER JOIN CONTRATOCFG ON CONTRATOCFG.CONTCONF = CONTRATO.CONTCONF    
    LEFT JOIN NFCABAGRFIN ON (NFCAB.ESTAB = NFCABAGRFIN.ESTAB)
        AND (NFCAB.SEQNOTA = NFCABAGRFIN.SEQNOTA)
    LEFT JOIN AGRFINDUPREC ON (AGRFINDUPREC.ESTAB = NFCABAGRFIN.ESTAB)
        AND (AGRFINDUPREC.SEQPAGAMENTO = NFCABAGRFIN.SEQPAGAMENTO)
    LEFT JOIN VDUPREC ON (VDUPREC.EMPRESA = AGRFINDUPREC.ESTAB)
        AND (VDUPREC.DUPREC = AGRFINDUPREC.DUPREC)
    WHERE CONTRATOCFG.ENTRADASAIDA = 'S'
    AND CONTRATO.ESTAB = $P{ESTAB} 
    AND CONTRATO.CONTRATO = $P{CONTRATO}
), 
CTE_NFITEMAPARTIRDE AS (
    SELECT DISTINCT
        nfcab_dest.ESTAB, 
        nfite_dest.CONTRATO, 
        nfcab_dest.DTENTSAI, 
        nfcab_dest.SEQNOTA,
        COALESCE(VDUPPAG.DUPPAG, CONTAMOVLAN.NRODOCTO) AS DUPREC,
        CONTAMOVLAN.VENCIMENTO AS DTVENCTO,
        CASE 
            WHEN NFCAB_DEST.NOTACONF = 286 
            THEN CONTAMOVLAN.VALOR * -1 
            ELSE CONTAMOVLAN.VALOR 
        END AS VALOR,
        CASE 
            WHEN CONTAMOVLAN.SITUACAO = 'B' 
            THEN 0 
            ELSE VDUPPAG.SALDO 
        END AS SALDO,
        CASE 
            WHEN CONTAMOVLAN.SITUACAO = 'B' 
            THEN CASE 
                     WHEN NFCAB_DEST.NOTACONF = 286 
                     THEN CONTAMOVLAN.VALOR * -1 
                     ELSE CONTAMOVLAN.VALOR 
                 END
            ELSE CASE 
                     WHEN NFCAB_DEST.NOTACONF = 286 
                     THEN (VDUPPAG.VALOR - VDUPPAG.SALDO) * -1 
                     ELSE (VDUPPAG.VALOR - VDUPPAG.SALDO) 
                 END 
        END AS RECEBIDO
    FROM NFITEMAPARTIRDE
    LEFT JOIN NFCAB nfcab_dest ON nfcab_dest.estab = NFITEMAPARTIRDE.estab 
        AND nfcab_dest.seqnota = NFITEMAPARTIRDE.seqnota 
    LEFT JOIN NFITEM nfite_dest ON nfite_dest.estab = nfcab_dest.estab 
        AND nfite_dest.seqnota = nfcab_dest.seqnota 
    LEFT JOIN NFCAB ON NFCAB.estab = NFITEMAPARTIRDE.estaborigem 
        AND NFCAB.seqnota = NFITEMAPARTIRDE.seqnotaorigem
        AND (NFCAB.STATUS <> 'C' OR NFCAB.STATUS IS NULL)
    LEFT JOIN NFITEM ON NFITEM.estab = NFCAB.estab 
        AND NFITEM.seqnota = NFCAB.seqnota   
    INNER JOIN CONTRATO ON (CONTRATO.ESTAB = nfcab_dest.ESTAB)
        AND (CONTRATO.CONTRATO = nfite_dest.CONTRATO)
    LEFT JOIN NFCABAGRFIN ON (nfcab_dest.ESTAB = NFCABAGRFIN.ESTAB)
        AND (nfcab_dest.SEQNOTA = NFCABAGRFIN.SEQNOTA)
    LEFT JOIN AGRFINCTAMOV ON (AGRFINCTAMOV.ESTAB = NFCABAGRFIN.ESTAB)
        AND (AGRFINCTAMOV.SEQPAGAMENTO = NFCABAGRFIN.SEQPAGAMENTO)
    LEFT JOIN CONTAMOVLAN ON (CONTAMOVLAN.ESTAB = AGRFINCTAMOV.ESTAB)
        AND (CONTAMOVLAN.NUMEROCM = AGRFINCTAMOV.NUMEROCM)
        AND (CONTAMOVLAN.SEQCM = AGRFINCTAMOV.SEQCM)
    LEFT JOIN CONTAMOVDUPP ON (CONTAMOVDUPP.ESTAB = CONTAMOVLAN.ESTAB)
        AND (CONTAMOVDUPP.NUMEROCM = CONTAMOVLAN.NUMEROCM)
        AND (CONTAMOVDUPP.SEQCM = CONTAMOVLAN.SEQCM)
    LEFT JOIN VDUPPAG ON (VDUPPAG.EMPRESA = CONTAMOVDUPP.ESTAB)
        AND (VDUPPAG.DUPPAG = CONTAMOVDUPP.DUPPAG)
    WHERE CONTRATO.ESTAB = $P{ESTAB} 
    AND CONTRATO.CONTRATO = $P{CONTRATO}
    AND NFCAB_DEST.NOTACONF = 286
),

CTE_CONTRATO_ENT AS (SELECT DISTINCT
        CONTRATONFITE.ESTAB, 
        CONTRATONFITE.CONTRATO, 
        NFCAB.DTENTSAI, 
        CONTRATONFITE.SEQNOTA,
        AGRFINDUPPAG.DUPPAG AS DUPREC,
        PDUPPAGA.DTVENCTO AS DTVENCTO,
        PDUPPAGA.VALOR,
        CASE 
            WHEN PDUPPAGA.QUITADA = 'S' 
            THEN 0 
            ELSE (SELECT COALESCE(PNSALDODUPPAG,0)
                        FROM TABLE (PSALDODUPPAG (PDUPPAGA.EMPRESA, PDUPPAGA.ESTABFORNECEDOR,
                          PDUPPAGA.FORNECEDOR, PDUPPAGA.DUPPAG, 0, CURRENT_DATE + 10000 ) ) PNSALDODUPPAG
                        ) 
        END AS SALDO,
        CASE 
            WHEN PDUPPAGA.QUITADA = 'S' 
            THEN PDUPPAGA.VALOR * -1 
            ELSE 
            (PDUPPAGA.VALOR - (SELECT COALESCE(PNSALDODUPPAG,0)
                                    FROM TABLE (PSALDODUPPAG (PDUPPAGA.EMPRESA, PDUPPAGA.ESTABFORNECEDOR,
                                      PDUPPAGA.FORNECEDOR, PDUPPAGA.DUPPAG, 0, CURRENT_DATE + 10000 ) ) PNSALDODUPPAG
                                    ) ) * -1 
            END RECEBIDO
    FROM CONTRATONFITE
    INNER JOIN NFCAB ON (NFCAB.ESTAB = CONTRATONFITE.ESTABNOTA)
        AND (NFCAB.SEQNOTA = CONTRATONFITE.SEQNOTA)
        AND (NFCAB.STATUS <> 'C' OR NFCAB.STATUS IS NULL)
        AND NFCAB.NOTACONF NOT IN (385,388)
    INNER JOIN CONTRATO ON (CONTRATO.ESTAB = CONTRATONFITE.ESTAB)
        AND (CONTRATO.CONTRATO = CONTRATONFITE.CONTRATO)
    INNER JOIN CONTRATOCFG ON CONTRATOCFG.CONTCONF = CONTRATO.CONTCONF    
    LEFT JOIN NFCABAGRFIN ON (NFCAB.ESTAB = NFCABAGRFIN.ESTAB)
        AND (NFCAB.SEQNOTA = NFCABAGRFIN.SEQNOTA)
    LEFT JOIN AGRFINDUPPAG ON (AGRFINDUPPAG.ESTAB = NFCABAGRFIN.ESTAB)
        AND (AGRFINDUPPAG.SEQPAGAMENTO = NFCABAGRFIN.SEQPAGAMENTO)
    LEFT JOIN PDUPPAGA ON (PDUPPAGA.EMPRESA = AGRFINDUPPAG.ESTAB)
        AND (PDUPPAGA.FORNECEDOR = AGRFINDUPPAG.FORNECEDOR)
        AND (PDUPPAGA.DUPPAG = AGRFINDUPPAG.DUPPAG)    

    WHERE CONTRATOCFG.ENTRADASAIDA = 'E'
    AND CONTRATO.ESTAB = $P{ESTAB} 
    AND CONTRATO.CONTRATO = $P{CONTRATO})

SELECT * FROM (
    SELECT * FROM CTE_CONTRATO_SAI
    UNION ALL
    SELECT * FROM CTE_NFITEMAPARTIRDE
    UNION ALL
    SELECT * FROM CTE_CONTRATO_ENT
) DADOS1
ORDER BY DADOS1.ESTAB, DADOS1.CONTRATO, DADOS1.DTENTSAI, DADOS1.SEQNOTA]]>
		</queryString>
		<field name="DUPREC" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="DUPREC"/>
		</field>
		<field name="DTVENCTO" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.label" value="DTVENCTO"/>
		</field>
		<field name="VALOR" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="VALOR"/>
		</field>
		<field name="SALDO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="SALDO"/>
		</field>
		<field name="RECEBIDO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="RECEBIDO"/>
		</field>
		<variable name="SALDO1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{SALDO}]]></variableExpression>
		</variable>
		<variable name="RECEBIDO1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{RECEBIDO}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="DTINI" class="java.util.Date"/>
	<parameter name="DTFIM" class="java.util.Date"/>
	<parameter name="ITEM" class="java.util.Collection" nestedType="java.lang.Integer"/>
	<parameter name="PRODUTOR" class="java.util.Collection" nestedType="java.lang.Integer"/>
	<parameter name="ESTAB" class="java.util.Collection" nestedType="java.lang.Integer"/>
	<parameter name="CONTRATO" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[WITH CONVERSAO AS (
    SELECT 
    *
    FROM 
    (
        SELECT moedaval.*,
               ROW_NUMBER() OVER (PARTITION BY moeda ORDER BY data DESC) AS rn
        FROM moedaval
    )dados
    -- WHERE rn = 1
),
FLUXO AS (
    SELECT
    ESTAB,
    CONTRATO,
    MAX(DTVENCTO) AS DTVENCTO
    FROM CONTRATODTVENCTO
    GROUP BY ESTAB,CONTRATO
)
select
*
from(
SELECT
    /* ESTAB */
    FILIAL.ESTAB,
    FILIAL.REDUZIDO AS ESTAB_COMPLETO,
    /* CONTRATO */
    CONTRATO.CONTRATO AS CTR_SEQ,
    CONTRATO.NUMCOMPRADOR AS CTR_CN,
    CONTRATO.CONTCONF ||' - '|| CONTRATOCFG.DESCRICAO AS CTR_CONFIG,
    CASE WHEN CONTRATOCFG.ENTRADASAIDA = 'S' THEN 'CONTRATO DE VENDA' ELSE 'CONTRATO DE COMPRA' END AS CTR_TIPO,
    CONTRATO.DTEMISSAO,
    CASE
        WHEN CONTRATO_U.TIPOPGTO ='AVISTA' THEN 'A VISTA'
        WHEN CONTRATO_U.TIPOPGTO ='5DIAUTIL' THEN '5º DIA ÚTIL DO MÊS SUBSEQUENTE AO MÊS DA ENTREGA'
        WHEN CONTRATO_U.TIPOPGTO ='SOBRERODAS' THEN 'APÓS O CARREGAMENTO'
        WHEN CONTRATO_U.TIPOPGTO ='ANTECIPADO' THEN 'ANTECIPADO - '||TO_CHAR(CONTRATODTVENCTO.DTVENCTO,'DD/MM/YYYY')
        WHEN CONTRATO_U.TIPOPGTO ='APRAZOCTR' THEN   NUMDIASPAGTO||'DIAS DA EMISSÃO DO CONTRATO'
        WHEN CONTRATO_U.TIPOPGTO ='APRAZOAMOSTRA' THEN NUMDIASPAGTO||' DIAS DA ENTREGA DA CARGA DE AMOSTRA'
        WHEN CONTRATO_U.TIPOPGTO ='APRAZOEMBARQUE' THEN NUMDIASPAGTO||' DIAS DO CARREGAMENTO DA MERCADORIA'
        WHEN CONTRATO_U.TIPOPGTO ='APRAZODESCARGA' THEN NUMDIASPAGTO||' DIAS DA ENTREGA DA MERCADORIA'
        WHEN CONTRATODTVENCTO.DTVENCTO IS NULL THEN  NUMDIASPAGTO||'DIAS'
        ELSE TO_CHAR(CONTRATODTVENCTO.DTVENCTO,'DD/MM/YYYY')
    END DTPGTO,
    CONTRATO.DTVENCTO,
    CONTRATO.DTMOVSALDO AS CTR_DT_VIG_INI,
    CONTRATO.DATALIMITEENT AS CTR_DT_VIG_FIN,
    SAFRAS.DESCRICAO AS CTR_SAFRA,
    /* PESSOA */
    CONTAMOV.NUMEROCM,
    CONTAMOV.NUMEROCM ||' - '|| CONTAMOV.NOME AS PESSOA,
    /* ITEM */
    ITEMAGRO.ITEM,
    ITEMAGRO.ITEM ||' - '|| ITEMAGRO.DESCRICAO AS PRODUTO,
    /* SALDO QUANTIDADE */
    CONTRATOITE.QUANTIDADE AS Q_QUANTIDADE,
    CONTRATOITE.VALORUNIT   as VALORUNIT,
    case when contrato.moeda = 2 then '$'||''||CONTRATOITE.VALORUNIT  else 'R$'||''||CONTRATOITE.VALORUNIT end unit,
    COALESCE((SELECT
                COALESCE(SUM(CONTRATONFITE.QUANTIDADE),0) FROM CONTRATONFITE
            INNER JOIN NFITEM ON
            NFITEM.ESTAB = CONTRATONFITE.ESTABNOTA AND
            NFITEM.SEQNOTA = CONTRATONFITE.SEQNOTA AND
            NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM
            INNER JOIN NFCAB ON
            NFCAB.ESTAB = NFITEM.ESTAB AND
            NFCAB.SEQNOTA = NFITEM.SEQNOTA
            INNER JOIN NFCFG ON
            NFCFG.NOTACONF = NFCAB.NOTACONF
            AND NFCFG.NOTACONF NOT IN (291, 385, 388)  -- AQUI
            INNER JOIN NATOPERACAO NAT ON
            NAT.NATUREZADAOPERACAO = NFCFG.NATUREZADAOPERACAO AND
            NAT.ENTRADASAIDA = NFCFG.ENTRADASAIDA AND
            NAT.TIPODCTO IN ('N','X','A','T')
            WHERE CONTRATONFITE.ESTAB = CONTRATOITE.ESTAB
            AND CONTRATONFITE.CONTRATO = CONTRATOITE.CONTRATO
            AND CONTRATONFITE.SEQITEM = CONTRATOITE.SEQITEM
            AND CONTRATONFITE.TIPOBAIXA IN ('A','Q'))
    ,0) AS Q_BAIXADO,
    COALESCE((SELECT
                COALESCE(SUM(CONTRATONFITE.QUANTIDADE),0) FROM CONTRATONFITE
            INNER JOIN CONTRATO ON
            CONTRATO.ESTAB = CONTRATONFITE.ESTAB AND
            CONTRATO.CONTRATO = CONTRATONFITE.CONTRATO
            INNER JOIN CONTRATOCFG_U ON CONTRATOCFG_U.CONTCONF = CONTRATO.CONTCONF
            INNER JOIN U_TIPOCTR ON u_tipoctr.u_tipoctr_id = contratocfg_u.u_tipoctr_id AND
            u_tipoctr.u_tipoctr_id NOT IN (11)
            INNER JOIN NFITEM ON
            NFITEM.ESTAB = CONTRATONFITE.ESTABNOTA AND
            NFITEM.SEQNOTA = CONTRATONFITE.SEQNOTA AND
            NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM
            INNER JOIN NFCAB ON
            NFCAB.ESTAB = NFITEM.ESTAB AND
            NFCAB.SEQNOTA = NFITEM.SEQNOTA
            INNER JOIN NFCFG ON
            NFCFG.NOTACONF = NFCAB.NOTACONF
            AND NFCFG.NOTACONF NOT IN (385, 388)  -- AQUI
            INNER JOIN NATOPERACAO NAT ON
            NAT.NATUREZADAOPERACAO = NFCFG.NATUREZADAOPERACAO AND
            NAT.ENTRADASAIDA = NFCFG.ENTRADASAIDA AND
            NAT.TIPODCTO = 'D'
            WHERE CONTRATONFITE.ESTAB = CONTRATOITE.ESTAB
            AND CONTRATONFITE.CONTRATO = CONTRATOITE.CONTRATO
            AND CONTRATONFITE.SEQITEM = CONTRATOITE.SEQITEM
            AND CONTRATONFITE.TIPOBAIXA IN ('A','Q'))
    ,0) AS Q_DEVOLVIDO,
    COALESCE((SELECT
                COALESCE(SUM(CONTRATOCANC.QUANTIDADE),0) FROM CONTRATOCANC
            WHERE CONTRATOCANC.ESTAB = CONTRATOITE.ESTAB
            AND CONTRATOCANC.CONTRATO = CONTRATOITE.CONTRATO
            AND CONTRATOCANC.SEQITEM  = CONTRATOITE.SEQITEM),0) +
            COALESCE((SELECT COALESCE(SUM(CONTRATONFITE.QUANTIDADE),0) FROM CONTRATONFITE
            INNER JOIN NFITEM ON
            NFITEM.ESTAB = CONTRATONFITE.ESTABNOTA AND
            NFITEM.SEQNOTA = CONTRATONFITE.SEQNOTA AND
            NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM
            INNER JOIN NFCAB ON
            NFCAB.ESTAB = NFITEM.ESTAB AND
            NFCAB.SEQNOTA = NFITEM.SEQNOTA
            INNER JOIN NFCFG ON
            NFCFG.NOTACONF = NFCAB.NOTACONF
            AND NFCFG.NOTACONF IN (291)
            INNER JOIN NATOPERACAO NAT ON
            NAT.NATUREZADAOPERACAO = NFCFG.NATUREZADAOPERACAO AND
            NAT.ENTRADASAIDA = NFCFG.ENTRADASAIDA AND
            NAT.TIPODCTO IN ('N','X','A')
            WHERE CONTRATONFITE.ESTAB = CONTRATOITE.ESTAB
            AND CONTRATONFITE.CONTRATO = CONTRATOITE.CONTRATO
            AND CONTRATONFITE.SEQITEM = CONTRATOITE.SEQITEM
            AND CONTRATONFITE.TIPOBAIXA IN ('A','Q'))
    ,0) AS Q_CANCELADO,
    /* SALDO VALOR */
    CONTRATOITE.VALORTOTAL * COALESCE(CONVERSAO.VALOR,C1.VALOR,1) AS V_VALORTOTAL,
    COALESCE((SELECT
                    COALESCE(SUM(CONTRATONFITE.VALOR),0) FROM CONTRATONFITE
        
            INNER JOIN NFITEM ON
            NFITEM.ESTAB = CONTRATONFITE.ESTABNOTA AND
            NFITEM.SEQNOTA = CONTRATONFITE.SEQNOTA AND
            NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM
            INNER JOIN NFCAB ON
            NFCAB.ESTAB = NFITEM.ESTAB AND
            NFCAB.SEQNOTA = NFITEM.SEQNOTA
            INNER JOIN NFCFG ON
            NFCFG.NOTACONF = NFCAB.NOTACONF
            AND NFCFG.NOTACONF NOT IN (291, 385, 388)  -- AQUI
            INNER JOIN NATOPERACAO NAT ON
            NAT.NATUREZADAOPERACAO = NFCFG.NATUREZADAOPERACAO AND
            NAT.ENTRADASAIDA = NFCFG.ENTRADASAIDA AND
            NAT.TIPODCTO IN ('N','X','A','T')
            WHERE CONTRATONFITE.ESTAB = CONTRATOITE.ESTAB
            AND CONTRATONFITE.CONTRATO = CONTRATOITE.CONTRATO
            AND CONTRATONFITE.SEQITEM = CONTRATOITE.SEQITEM
            AND CONTRATONFITE.TIPOBAIXA IN ('A','V'))
    ,0) AS V_BAIXADO,
    COALESCE((SELECT
                COALESCE(SUM(CONTRATONFITE.VALOR),0) FROM CONTRATONFITE
            INNER JOIN CONTRATO ON
            CONTRATO.ESTAB = CONTRATONFITE.ESTAB AND
            CONTRATO.CONTRATO = CONTRATONFITE.CONTRATO
            INNER JOIN CONTRATOCFG_U ON CONTRATOCFG_U.CONTCONF = CONTRATO.CONTCONF
            INNER JOIN U_TIPOCTR ON u_tipoctr.u_tipoctr_id = contratocfg_u.u_tipoctr_id AND
            u_tipoctr.u_tipoctr_id NOT IN (11)
            INNER JOIN NFITEM ON
            NFITEM.ESTAB = CONTRATONFITE.ESTABNOTA AND
            NFITEM.SEQNOTA = CONTRATONFITE.SEQNOTA AND
            NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM
            INNER JOIN NFCAB ON
            NFCAB.ESTAB = NFITEM.ESTAB AND
            NFCAB.SEQNOTA = NFITEM.SEQNOTA
            INNER JOIN NFCFG ON
            NFCFG.NOTACONF = NFCAB.NOTACONF
            AND NFCFG.NOTACONF NOT IN (385, 388)  -- AQUI
            INNER JOIN NATOPERACAO NAT ON
            NAT.NATUREZADAOPERACAO = NFCFG.NATUREZADAOPERACAO AND
            NAT.ENTRADASAIDA = NFCFG.ENTRADASAIDA AND
            NAT.TIPODCTO = 'D'
            WHERE CONTRATONFITE.ESTAB = CONTRATOITE.ESTAB
            AND CONTRATONFITE.CONTRATO = CONTRATOITE.CONTRATO
            AND CONTRATONFITE.SEQITEM = CONTRATOITE.SEQITEM
            AND CONTRATONFITE.TIPOBAIXA IN ('A','V'))
    ,0) AS V_DEVOLVIDO,
    COALESCE((SELECT
                    COALESCE(SUM(CONTRATOCANC.VALOR),0) FROM CONTRATOCANC
            WHERE CONTRATOCANC.ESTAB = CONTRATOITE.ESTAB
                AND CONTRATOCANC.CONTRATO = CONTRATOITE.CONTRATO
                AND CONTRATOCANC.SEQITEM  = CONTRATOITE.SEQITEM),0) +
    COALESCE((SELECT
                COALESCE(SUM(CONTRATONFITE.VALOR),0)
            FROM CONTRATONFITE
            INNER JOIN NFITEM
                ON NFITEM.ESTAB = CONTRATONFITE.ESTABNOTA
                AND NFITEM.SEQNOTA = CONTRATONFITE.SEQNOTA
                AND NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM
            INNER JOIN NFCAB
                ON NFCAB.ESTAB = NFITEM.ESTAB
                AND NFCAB.SEQNOTA = NFITEM.SEQNOTA
            INNER JOIN NFCFG
                ON NFCFG.NOTACONF = NFCAB.NOTACONF
                AND NFCFG.NOTACONF IN (291)
            INNER JOIN NATOPERACAO NAT
                ON NAT.NATUREZADAOPERACAO = NFCFG.NATUREZADAOPERACAO
                AND NAT.ENTRADASAIDA = NFCFG.ENTRADASAIDA
                AND NAT.TIPODCTO IN ('N','X','A')
            WHERE CONTRATONFITE.ESTAB = CONTRATOITE.ESTAB
                AND CONTRATONFITE.CONTRATO = CONTRATOITE.CONTRATO
                AND CONTRATONFITE.SEQITEM = CONTRATOITE.SEQITEM
                AND CONTRATONFITE.TIPOBAIXA IN ('A','V'))
    ,0) AS V_CANCELADO,
    CONTRATO_U.STATUSASS,
    CONTRATO_U.STATUSAPROV,
    CONTRATO_U.STATUSFAT,
    CONTRATO_U.TIPOFRETES
FROM CONTRATO
INNER JOIN FILIAL
    ON FILIAL.ESTAB = CONTRATO.ESTAB
INNER JOIN CONTRATOCFG
    ON CONTRATOCFG.CONTCONF = CONTRATO.CONTCONF
INNER JOIN CONTAMOV
    ON CONTAMOV.NUMEROCM = CONTRATO.NUMEROCM
INNER JOIN CONTRATOITE
    ON CONTRATOITE.ESTAB = CONTRATO.ESTAB
    AND CONTRATOITE.CONTRATO = CONTRATO.CONTRATO
INNER JOIN ITEMAGRO
    ON ITEMAGRO.ITEM = CONTRATOITE.ITEM
INNER JOIN SAFRAS
    ON SAFRAS.SAFRA = CONTRATO.SAFRA
LEFT JOIN CONTRATO_U
    ON CONTRATO_U.ESTAB = CONTRATO.ESTAB
    AND CONTRATO_U.CONTRATO = CONTRATO.CONTRATO
LEFT JOIN CONTRATODTVENCTO
    ON CONTRATODTVENCTO.ESTAB = CONTRATO.ESTAB
    AND CONTRATODTVENCTO.CONTRATO = CONTRATO.CONTRATO
    AND ((CONTRATO_U.TIPOPGTO = 'ANTECIPADO')
    OR (CONTRATO_U.TIPOPGTO IN ('APRAZO','APRAZOCTR','APRAZOAMOSTRA','APRAZOEMBARQUE','APRAZODESCARGA')))
INNER JOIN CONTRATOCFG_U ON CONTRATOCFG_U.CONTCONF = CONTRATO.CONTCONF
 
LEFT JOIN U_TIPOCTR ON u_tipoctr.u_tipoctr_id = contratocfg_u.u_tipoctr_id  
LEFT JOIN FLUXO ON
    FLUXO.ESTAB = CONTRATO.ESTAB
    AND FLUXO.CONTRATO = CONTRATO.CONTRATO
LEFT JOIN CONVERSAO 
    ON CONVERSAO.MOEDA = CONTRATO.MOEDA
    AND CONVERSAO.DATA = FLUXO.DTVENCTO
LEFT JOIN CONVERSAO C1 ON
    C1.MOEDA = CONTRATO.MOEDA
    AND C1.RN = 1
    
 WHERE CONTRATO.DTEMISSAO BETWEEN $P{DTINI} AND $P{DTFIM}
 AND $X{IN,CONTRATO.NUMEROCM,PRODUTOR}
 AND $X{IN,CONTRATO.ESTAB,ESTAB}
 AND $X{IN,CONTRATOITE.ITEM,ITEM} 
 AND (CONTRATO.CONTRATO = $P{CONTRATO} OR 0 = $P{CONTRATO})
 and u_tipoctr.u_tipoctr_id not in (11)

UNION ALL

SELECT
    /* ESTAB */
    FILIAL.ESTAB,
    FILIAL.REDUZIDO AS ESTAB_COMPLETO,
    /* CONTRATO */
    CONTRATO.CONTRATO AS CTR_SEQ,
    CONTRATO.NUMCOMPRADOR AS CTR_CN,
    CONTRATO.CONTCONF ||' - '|| CONTRATOCFG.DESCRICAO AS CTR_CONFIG,
    CASE WHEN CONTRATOCFG.ENTRADASAIDA = 'S' THEN 'CONTRATO DE VENDA' ELSE 'CONTRATO DE COMPRA' END AS CTR_TIPO,
    CONTRATO.DTEMISSAO,
    CASE
        WHEN CONTRATO_U.TIPOPGTO ='AVISTA' THEN 'A VISTA'
        WHEN CONTRATO_U.TIPOPGTO ='5DIAUTIL' THEN '5º DIA ÚTIL DO MÊS SUBSEQUENTE AO MÊS DA ENTREGA'
        WHEN CONTRATO_U.TIPOPGTO ='SOBRERODAS' THEN 'APÓS O CARREGAMENTO'
        WHEN CONTRATO_U.TIPOPGTO ='ANTECIPADO' THEN 'ANTECIPADO - '||TO_CHAR(CONTRATODTVENCTO.DTVENCTO,'DD/MM/YYYY')
        WHEN CONTRATO_U.TIPOPGTO ='APRAZOCTR' THEN   NUMDIASPAGTO||'DIAS DA EMISSÃO DO CONTRATO'
        WHEN CONTRATO_U.TIPOPGTO ='APRAZOAMOSTRA' THEN NUMDIASPAGTO||' DIAS DA ENTREGA DA CARGA DE AMOSTRA'
        WHEN CONTRATO_U.TIPOPGTO ='APRAZOEMBARQUE' THEN NUMDIASPAGTO||' DIAS DO CARREGAMENTO DA MERCADORIA'
        WHEN CONTRATO_U.TIPOPGTO ='APRAZODESCARGA' THEN NUMDIASPAGTO||' DIAS DA ENTREGA DA MERCADORIA'
        WHEN CONTRATODTVENCTO.DTVENCTO IS NULL THEN  NUMDIASPAGTO||'DIAS'
        ELSE TO_CHAR(CONTRATODTVENCTO.DTVENCTO,'DD/MM/YYYY')
    END DTPGTO,
    CONTRATO.DTVENCTO,
    CONTRATO.DTMOVSALDO AS CTR_DT_VIG_INI,
    CONTRATO.DATALIMITEENT AS CTR_DT_VIG_FIN,
    SAFRAS.DESCRICAO AS CTR_SAFRA,
    /* PESSOA */
    CONTAMOV.NUMEROCM,
    CONTAMOV.NUMEROCM ||' - '|| CONTAMOV.NOME AS PESSOA,
    /* ITEM */
    ITEMAGRO.ITEM,
    ITEMAGRO.ITEM ||' - '|| ITEMAGRO.DESCRICAO AS PRODUTO,
    /* SALDO QUANTIDADE */
    CONTRATOITE.QUANTIDADE AS Q_QUANTIDADE,
    CONTRATOITE.VALORUNIT,
    case when contrato.moeda = 2 then '$'||''||CONTRATOITE.VALORUNIT  else 'R$'||''||CONTRATOITE.VALORUNIT end unit,
    COALESCE((SELECT
                COALESCE(SUM(CONTRATONFITE.QUANTIDADE),0) FROM CONTRATONFITE
            INNER JOIN CONTRATO ON
            CONTRATO.ESTAB = CONTRATONFITE.ESTAB AND
            CONTRATO.CONTRATO = CONTRATONFITE.CONTRATO
            INNER JOIN CONTRATOCFG_U ON CONTRATOCFG_U.CONTCONF = CONTRATO.CONTCONF
            INNER JOIN U_TIPOCTR ON u_tipoctr.u_tipoctr_id = contratocfg_u.u_tipoctr_id AND
            u_tipoctr.u_tipoctr_id IN (11)            
            INNER JOIN NFITEM ON
            NFITEM.ESTAB = CONTRATONFITE.ESTABNOTA AND
            NFITEM.SEQNOTA = CONTRATONFITE.SEQNOTA AND
            NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM
            INNER JOIN NFCAB ON
            NFCAB.ESTAB = NFITEM.ESTAB AND
            NFCAB.SEQNOTA = NFITEM.SEQNOTA
            INNER JOIN NFCFG ON
            NFCFG.NOTACONF = NFCAB.NOTACONF
            AND NFCFG.NOTACONF NOT IN (291, 385, 388)  -- AQUI
            INNER JOIN NATOPERACAO NAT ON
            NAT.NATUREZADAOPERACAO = NFCFG.NATUREZADAOPERACAO AND
            NAT.ENTRADASAIDA = NFCFG.ENTRADASAIDA AND
            NAT.TIPODCTO IN ('D')
            WHERE CONTRATONFITE.ESTAB = CONTRATOITE.ESTAB
            AND CONTRATONFITE.CONTRATO = CONTRATOITE.CONTRATO
            AND CONTRATONFITE.SEQITEM = CONTRATOITE.SEQITEM
            AND CONTRATONFITE.TIPOBAIXA IN ('A','Q'))
    ,0) AS Q_BAIXADO,
    COALESCE((SELECT
                COALESCE(SUM(CONTRATONFITE.QUANTIDADE),0) FROM CONTRATONFITE
            INNER JOIN CONTRATO ON
            CONTRATO.ESTAB = CONTRATONFITE.ESTAB AND
            CONTRATO.CONTRATO = CONTRATONFITE.CONTRATO
            INNER JOIN CONTRATOCFG_U ON CONTRATOCFG_U.CONTCONF = CONTRATO.CONTCONF
            INNER JOIN U_TIPOCTR ON u_tipoctr.u_tipoctr_id = contratocfg_u.u_tipoctr_id AND
            u_tipoctr.u_tipoctr_id NOT IN (11)
            INNER JOIN NFITEM ON
            NFITEM.ESTAB = CONTRATONFITE.ESTABNOTA AND
            NFITEM.SEQNOTA = CONTRATONFITE.SEQNOTA AND
            NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM
            INNER JOIN NFCAB ON
            NFCAB.ESTAB = NFITEM.ESTAB AND
            NFCAB.SEQNOTA = NFITEM.SEQNOTA
            INNER JOIN NFCFG ON
            NFCFG.NOTACONF = NFCAB.NOTACONF
            AND NFCFG.NOTACONF NOT IN (385, 388)  -- AQUI
            INNER JOIN NATOPERACAO NAT ON
            NAT.NATUREZADAOPERACAO = NFCFG.NATUREZADAOPERACAO AND
            NAT.ENTRADASAIDA = NFCFG.ENTRADASAIDA AND
            NAT.TIPODCTO = 'D'
            WHERE CONTRATONFITE.ESTAB = CONTRATOITE.ESTAB
            AND CONTRATONFITE.CONTRATO = CONTRATOITE.CONTRATO
            AND CONTRATONFITE.SEQITEM = CONTRATOITE.SEQITEM
            AND CONTRATONFITE.TIPOBAIXA IN ('A','Q'))
    ,0) AS Q_DEVOLVIDO,
    COALESCE((SELECT
                COALESCE(SUM(CONTRATOCANC.QUANTIDADE),0) FROM CONTRATOCANC
            WHERE CONTRATOCANC.ESTAB = CONTRATOITE.ESTAB
            AND CONTRATOCANC.CONTRATO = CONTRATOITE.CONTRATO
            AND CONTRATOCANC.SEQITEM  = CONTRATOITE.SEQITEM),0) +
            COALESCE((SELECT COALESCE(SUM(CONTRATONFITE.QUANTIDADE),0) FROM CONTRATONFITE
            INNER JOIN NFITEM ON
            NFITEM.ESTAB = CONTRATONFITE.ESTABNOTA AND
            NFITEM.SEQNOTA = CONTRATONFITE.SEQNOTA AND
            NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM
            INNER JOIN NFCAB ON
            NFCAB.ESTAB = NFITEM.ESTAB AND
            NFCAB.SEQNOTA = NFITEM.SEQNOTA
            INNER JOIN NFCFG ON
            NFCFG.NOTACONF = NFCAB.NOTACONF
            AND NFCFG.NOTACONF IN (291)
            INNER JOIN NATOPERACAO NAT ON
            NAT.NATUREZADAOPERACAO = NFCFG.NATUREZADAOPERACAO AND
            NAT.ENTRADASAIDA = NFCFG.ENTRADASAIDA AND
            NAT.TIPODCTO IN ('N','X','A')
            WHERE CONTRATONFITE.ESTAB = CONTRATOITE.ESTAB
            AND CONTRATONFITE.CONTRATO = CONTRATOITE.CONTRATO
            AND CONTRATONFITE.SEQITEM = CONTRATOITE.SEQITEM
            AND CONTRATONFITE.TIPOBAIXA IN ('A','Q'))
    ,0) AS Q_CANCELADO,
    /* SALDO VALOR */
    CONTRATOITE.VALORTOTAL * COALESCE(CONVERSAO.VALOR,C1.VALOR,1) AS V_VALORTOTAL,
    0 AS V_BAIXADO,
    COALESCE((SELECT
                COALESCE(SUM(CONTRATONFITE.VALOR),0) FROM CONTRATONFITE
            INNER JOIN CONTRATO ON
            CONTRATO.ESTAB = CONTRATONFITE.ESTAB AND
            CONTRATO.CONTRATO = CONTRATONFITE.CONTRATO
            INNER JOIN CONTRATOCFG_U ON CONTRATOCFG_U.CONTCONF = CONTRATO.CONTCONF
            INNER JOIN U_TIPOCTR ON u_tipoctr.u_tipoctr_id = contratocfg_u.u_tipoctr_id AND
            u_tipoctr.u_tipoctr_id NOT IN (11)            
            INNER JOIN NFITEM ON
            NFITEM.ESTAB = CONTRATONFITE.ESTABNOTA AND
            NFITEM.SEQNOTA = CONTRATONFITE.SEQNOTA AND
            NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM
            INNER JOIN NFCAB ON
            NFCAB.ESTAB = NFITEM.ESTAB AND
            NFCAB.SEQNOTA = NFITEM.SEQNOTA
            INNER JOIN NFCFG ON
            NFCFG.NOTACONF = NFCAB.NOTACONF
            AND NFCFG.NOTACONF NOT IN (385, 388)  -- AQUI
            INNER JOIN NATOPERACAO NAT ON
            NAT.NATUREZADAOPERACAO = NFCFG.NATUREZADAOPERACAO AND
            NAT.ENTRADASAIDA = NFCFG.ENTRADASAIDA AND
            NAT.TIPODCTO = 'D'
            WHERE CONTRATONFITE.ESTAB = CONTRATOITE.ESTAB
            AND CONTRATONFITE.CONTRATO = CONTRATOITE.CONTRATO
            AND CONTRATONFITE.SEQITEM = CONTRATOITE.SEQITEM
            AND CONTRATONFITE.TIPOBAIXA IN ('A','V'))
    ,0) AS V_DEVOLVIDO,
    COALESCE((SELECT
                    COALESCE(SUM(CONTRATOCANC.VALOR),0) FROM CONTRATOCANC
            WHERE CONTRATOCANC.ESTAB = CONTRATOITE.ESTAB
                AND CONTRATOCANC.CONTRATO = CONTRATOITE.CONTRATO
                AND CONTRATOCANC.SEQITEM  = CONTRATOITE.SEQITEM),0) +
    COALESCE((SELECT
                COALESCE(SUM(CONTRATONFITE.VALOR),0)
            FROM CONTRATONFITE
            INNER JOIN NFITEM
                ON NFITEM.ESTAB = CONTRATONFITE.ESTABNOTA
                AND NFITEM.SEQNOTA = CONTRATONFITE.SEQNOTA
                AND NFITEM.SEQNOTAITEM = CONTRATONFITE.SEQNOTAITEM
            INNER JOIN NFCAB
                ON NFCAB.ESTAB = NFITEM.ESTAB
                AND NFCAB.SEQNOTA = NFITEM.SEQNOTA
            INNER JOIN NFCFG
                ON NFCFG.NOTACONF = NFCAB.NOTACONF
                AND NFCFG.NOTACONF IN (291)
            INNER JOIN NATOPERACAO NAT
                ON NAT.NATUREZADAOPERACAO = NFCFG.NATUREZADAOPERACAO
                AND NAT.ENTRADASAIDA = NFCFG.ENTRADASAIDA
                AND NAT.TIPODCTO IN ('N','X','A')
            WHERE CONTRATONFITE.ESTAB = CONTRATOITE.ESTAB
                AND CONTRATONFITE.CONTRATO = CONTRATOITE.CONTRATO
                AND CONTRATONFITE.SEQITEM = CONTRATOITE.SEQITEM
                AND CONTRATONFITE.TIPOBAIXA IN ('A','V'))
    ,0) AS V_CANCELADO,
    CONTRATO_U.STATUSASS,
    CONTRATO_U.STATUSAPROV,
    CONTRATO_U.STATUSFAT,
    CONTRATO_U.TIPOFRETES
FROM CONTRATO
INNER JOIN FILIAL
    ON FILIAL.ESTAB = CONTRATO.ESTAB
INNER JOIN CONTRATOCFG
    ON CONTRATOCFG.CONTCONF = CONTRATO.CONTCONF
INNER JOIN CONTAMOV
    ON CONTAMOV.NUMEROCM = CONTRATO.NUMEROCM
INNER JOIN CONTRATOITE
    ON CONTRATOITE.ESTAB = CONTRATO.ESTAB
    AND CONTRATOITE.CONTRATO = CONTRATO.CONTRATO
INNER JOIN ITEMAGRO
    ON ITEMAGRO.ITEM = CONTRATOITE.ITEM
INNER JOIN SAFRAS
    ON SAFRAS.SAFRA = CONTRATO.SAFRA
LEFT JOIN CONTRATO_U
    ON CONTRATO_U.ESTAB = CONTRATO.ESTAB
    AND CONTRATO_U.CONTRATO = CONTRATO.CONTRATO
LEFT JOIN CONTRATODTVENCTO
    ON CONTRATODTVENCTO.ESTAB = CONTRATO.ESTAB
    AND CONTRATODTVENCTO.CONTRATO = CONTRATO.CONTRATO
    AND ((CONTRATO_U.TIPOPGTO = 'ANTECIPADO')
    OR (CONTRATO_U.TIPOPGTO IN ('APRAZO','APRAZOCTR','APRAZOAMOSTRA','APRAZOEMBARQUE','APRAZODESCARGA')))
INNER JOIN CONTRATOCFG_U ON CONTRATOCFG_U.CONTCONF = CONTRATO.CONTCONF
LEFT JOIN U_TIPOCTR ON u_tipoctr.u_tipoctr_id = contratocfg_u.u_tipoctr_id 
LEFT JOIN FLUXO ON
    FLUXO.ESTAB = CONTRATO.ESTAB
    AND FLUXO.CONTRATO = CONTRATO.CONTRATO
LEFT JOIN CONVERSAO 
    ON CONVERSAO.MOEDA = CONTRATO.MOEDA
    AND CONVERSAO.DATA = FLUXO.DTVENCTO
LEFT JOIN CONVERSAO C1 ON
    C1.MOEDA = CONTRATO.MOEDA
    AND C1.RN = 1

 WHERE CONTRATO.DTEMISSAO BETWEEN $P{DTINI} AND $P{DTFIM}
 AND $X{IN,CONTRATO.NUMEROCM,PRODUTOR}
 AND $X{IN,CONTRATO.ESTAB,ESTAB}
 AND $X{IN,CONTRATOITE.ITEM,ITEM} 
 AND (CONTRATO.CONTRATO = $P{CONTRATO} OR 0 = $P{CONTRATO})
 and u_tipoctr.u_tipoctr_id in (11)
 
 )DADOS
ORDER BY
ESTAB,
CTR_SEQ]]>
	</queryString>
	<field name="ESTAB" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="ESTAB"/>
	</field>
	<field name="ESTAB_COMPLETO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="ESTAB_COMPLETO"/>
	</field>
	<field name="CTR_SEQ" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="CTR_SEQ"/>
	</field>
	<field name="CTR_CN" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="CTR_CN"/>
	</field>
	<field name="CTR_CONFIG" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="CTR_CONFIG"/>
	</field>
