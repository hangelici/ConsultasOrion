		<property name="com.jaspersoft.studio.field.label" value="VALORUNIT"/>
	</field>
	<field name="UNIT" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="UNIT"/>
	</field>
	<field name="Q_BAIXADO" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="Q_BAIXADO"/>
	</field>
	<field name="Q_DEVOLVIDO" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="Q_DEVOLVIDO"/>
	</field>
	<field name="Q_CANCELADO" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="Q_CANCELADO"/>
	</field>
	<field name="V_VALORTOTAL" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="V_VALORTOTAL"/>
	</field>
	<field name="V_BAIXADO" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="V_BAIXADO"/>
	</field>
	<field name="V_DEVOLVIDO" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="V_DEVOLVIDO"/>
	</field>
	<field name="V_CANCELADO" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="V_CANCELADO"/>
	</field>
	<field name="STATUSASS" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="STATUSASS"/>
	</field>
	<field name="STATUSAPROV" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="STATUSAPROV"/>
	</field>
